# ── Anthropic API ────────────────────────────────────────────────────────────
# Required. Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# ── MontiCore SysML v2 Parser ────────────────────────────────────────────────
# Path to the MCSysMLv2.jar file (P5 ValidatorAgent, Layer 1 — syntactic).
# Download: wget -q -O tools/MCSysMLv2.jar https://www.monticore.de/download/MCSysMLv2.jar
# Requires Java 11+. Leave blank or unset to skip MontiCore validation
# (Layers 2 and 3 — Structural and Coherence — will still run).
MONTICORE_JAR_PATH=tools/MCSysMLv2.jar

# ── Pipeline base directory ──────────────────────────────────────────────────
# Root directory where the pipeline writes intermediate artefacts.
# In Google Colab this defaults to /content/drive/MyDrive/COSME_SysMLv2.
# For local execution, set to any writable path (e.g. ./outputs/run_local).
COSME_BASE_DIR=./outputs/run_local

# ── LLM backbone ────────────────────────────────────────────────────────────
# The model used for LLM-bound agents (P1, P2, P4, P6).
# To reproduce Sonnet results:  LLM_MODEL=claude-sonnet-4-5
# To reproduce Haiku results:   LLM_MODEL=claude-haiku-4-5-20251001
# NOTE: 'claude-sonnet-4-5' is a moving alias (the Haiku id is pinned to a dated
#       snapshot). See docs/reproducibility.md for the environment date of the
#       runs reported in the paper.
LLM_MODEL=claude-sonnet-4-5
